# Copy to .env and fill in. .env is gitignored — never commit real keys.
# The CLI loads .env automatically; real environment variables take precedence.

# Groq (free tier, OpenAI-compatible). Key from https://console.groq.com
GROQ_API_KEY=gsk_...

